# Postgres (docker-compose service "db")
# Superuser connection — used only for running migrations (creates roles/extensions/functions).
DATABASE_MIGRATE_URL=postgres://postgres:postgres@localhost:5432/banco_alimentos

# App connection — RLS-enforced, used for all normal request handling.
DATABASE_URL=postgres://app_user:changeme_app_user@localhost:5432/banco_alimentos

# Privileged connection (BYPASSRLS) — used only from explicit server-only admin code paths.
DATABASE_ADMIN_URL=postgres://app_admin:changeme_app_admin@localhost:5432/banco_alimentos

# Auth.js
# Generate with: npx auth secret
AUTH_SECRET=

APP_ORIGIN=http://localhost:3000

# External Ecuadorian ID/business-registry lookup proxies
SERVICIO_CONSULTAS_DINARAP=http://servicio-dinarap.test/consultar
SERVICIO_CONSULTAS_RUC=http://servicio-ruc.test/datosUnificados

NEXT_PUBLIC_MAPBOX_API_KEY=pk.test

# Email (transactional notifications)
EMAIL_PROVIDER=gmail
EMAIL_GMAIL_USER=tu-cuenta@gmail.com
EMAIL_GMAIL_PASS=tu-contrasena-de-aplicacion
EMAIL_GMAIL_PORT=465
#EMAIL_GMAIL_SECURE=false
#EMAIL_GMAIL_REQUIRE_TLS=true
EMAIL_FROM_NAME=Banco de Alimentos
#EMAIL_FROM_ADDRESS=notificaciones@tudominio.com
#EMAIL_SUPPRESS_SEND=true
#EMAIL_LOG_ONLY=true
